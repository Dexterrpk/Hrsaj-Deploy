# Copie para config.env e preencha localmente.
# config.env não deve ser enviado ao GitHub.
ADMIN_USER=suporte
ADMIN_PASS='ALTERE_LOCALMENTE'
DEFAULT_USER=same
DEFAULT_PASS='ALTERE_LOCALMENTE'

PRINTSPY_IP=192.168.1.211
PRINTSPY_PORT=5051

WEASIS_DESCRIPTION=BACKUP
WEASIS_AET=BACKUP
